# Large binary/data artifacts — preserved on disk, pinned by hash in manifests.
# Generator weights (986 MB): pinned in corpus/generator_config.json
generator_runtime/artifacts/

# Round 1 derived caches and bulky raw dumps. Same convention as the rule above:
# preserved on disk, pinned by sha256 in
# experiments/results/ARTIFACT_MANIFEST.sha256, not committed as blobs.
# The BM25 index needs no file (packed in-memory arrays). The B2 static-embedding
# document cache is 40,873,912 B and is fully reconstructible from the pinned
# corpus + pinned revision, so it is a derived artefact, not a source one.
artifacts/
experiments/artifacts/
experiments/results/floor_probe/*_packets/
# Corpus canonical JSONL (42 MB): pinned in corpus/build_manifest.json + provenance.json
corpus/corpus.jsonl
# Raw Wikipedia snapshots (41 MB) and the superseded pilot archive (39 MB)
corpus/raw/
corpus/archive/
# Private evaluation content: never published. The real private directory
# lives OUTSIDE the repo (LMR_PRIVATE_EVAL_DIR, see docs/private-eval-custody.md);
# these patterns exist so an accidental `git add` cannot stage private data
# that was mistakenly written into the repo. Guarded by
# tests/test_private_eval_tripwire.py.
corpus/heldout_labels.sealed.json
corpus/labels.json
corpus/labels.sealed.json
*private*label*
*private_test*.json
*private_eval_dir*
qa-private-*.json
*.seal
seal.sha256
# The ONE private-test file that MUST be tracked: the opaque manifest carries
# the seal digest that binds the out-of-repo private test to THIS repository.
# A clone that lacks it has no way to verify the private boundary, so ignoring it
# would silently break the freeze gate on every fresh checkout. It is content-free
# by contract (counts, hashes, split metadata, custody rules) and
# tests/test_private_eval_tripwire.py asserts it stays content-free.
!corpus/private_test_manifest.json

# Phase 7 scale layer: raw snapshots and the built distractor DAG are large
# and are hash-pinned in corpus/scale/tier_*.json + scale_build_manifest.json.
corpus/scale/raw/
corpus/scale/distractor.jsonl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
